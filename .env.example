# Copy to .env and fill in. .env is gitignored - never commit it.

# --- Simkl (required; the event source) -------------------------------------
# Client ID: https://simkl.com/settings/developer
# Token:     OAuth2 access token for your own account
SIMKL_CLIENT_ID=
SIMKL_TOKEN=

# --- AniList (required when ENABLE_ANILIST=true) -----------------------------
# https://anilist.co/settings/developer
ANILIST_TOKEN=

# --- MyAnimeList (required when ENABLE_MAL=true) -----------------------------
# Client ID: MyAnimeList -> Account Settings -> API -> Create ID
# Tokens:    python -m aniprogress.mal_auth --client-id YOUR_MAL_CLIENT_ID
MAL_CLIENT_ID=
MAL_TOKEN=
MAL_REFRESH_TOKEN=

# --- Floppy (required when ENABLE_FLOPPY_RATINGS=true) ------------------------
# Ratings sync both ways with AniList, decimals preserved on both sides.
# URL:   your Floppy base URL, no trailing path (e.g. https://floppy.example.com)
# Token: Floppy -> Settings -> API
FLOPPY_URL=
FLOPPY_TOKEN=
